    @staticmethod
    def _print_builtin(*values: Any, sep: str = " ", end: str = "\n") -> None:
        print(*values, sep=sep, end=end); return None

    @staticmethod
    def _assert_true(condition: Any, message: str = "Assertion failed") -> bool:
        if not condition: raise EasyScriptError(str(message))
        return True

    def _resolve_function_argument(self, value: Any) -> Any:
        if isinstance(value, (EasyFunction,)) or callable(value): return value
        name = str(value)
        fn = self.functions.get(name)
        if fn is None: fn = self.functions.get(name.lower())
        if fn is None: fn = self.builtins.get(name.lower())
        if fn is None: raise EasyScriptError(f"Onbekende EasyScript-functie: {name}")
        return fn

    def _map_to(self, function_name: Any, iterable: Any) -> list[Any]:
        fn = self._resolve_function_argument(function_name)
        return [self.call_value(fn, [item]) for item in iterable]

    def _filter_by(self, function_name: Any, iterable: Any) -> list[Any]:
        fn = self._resolve_function_argument(function_name)
        return [item for item in iterable if self.call_value(fn, [item])]

    def _reduce_by(self, function_name: Any, iterable: Any, initial: Any = ...) -> Any:
        fn = self._resolve_function_argument(function_name)
        iterator = iter(iterable)
        if initial is ...:
            try: result = next(iterator)
            except StopIteration as exc: raise EasyScriptError("REDUCE cannot process an empty list without an initial value") from exc
        else: result = initial
        for item in iterator: result = self.call_value(fn, [result, item])
        return result

    @staticmethod
    def _is_callable(value: Any) -> bool:
        return isinstance(value, EasyFunction) or callable(value)

    @staticmethod
    def _is_subclass_type(child: Any, parent: Any) -> bool:
        known_types = {
            "object": object, "none": type(None), "nonetype": type(None),
            "bool": bool, "int": int, "float": float, "complex": complex,
            "str": str, "string": str, "list": list, "tuple": tuple,
            "dict": dict, "set": set, "frozenset": frozenset,
            "bytes": bytes, "bytearray": bytearray,
        }
        child_type = child if isinstance(child, type) else known_types.get(str(child).lower())
        parent_type = parent if isinstance(parent, type) else known_types.get(str(parent).lower())
        if child_type is None or parent_type is None:
            raise EasyScriptError("IS_SUBCLASS verwacht bekende types zoals \"int\", \"float\" of \"object\"")
        return issubclass(child_type, parent_type)

    @staticmethod
    def _next_item(iterator: Any, default: Any = ... ) -> Any:
        if default is ...: return next(iterator)
        return next(iterator, default)

    def _dir(self, value: Any = None) -> list[str]:
        if value is None:
            keys = set(self.variables) | set(self.functions) | set(self.builtins)
            for scope in self.scopes: keys.update(scope)
            return sorted(keys)
        if isinstance(value, dict): return sorted(map(str, value.keys()))
        if isinstance(value, (list, tuple, str, set, frozenset)): return ["count", "index", "length"] if not isinstance(value, (set, frozenset)) else ["add", "discard", "remove"]
        return ["type"]

    def _globals(self) -> dict[str, Any]:
        return dict(self.variables)

    def _locals(self) -> dict[str, Any]:
        return dict(self.scopes[-1]) if self.scopes else dict(self.variables)

    # ----------------------------- line parsing -----------------------------
    @staticmethod
    def split_args(source: str) -> list[str]:
        """Split comma-separated arguments while respecting quotes and brackets."""
        args, start = [], 0
        stack: list[str] = []
        quote: str | None = None
        escaped = False
        matching = {")": "(", "]": "[", "}": "{"}
        for i, char in enumerate(source):
            if quote:
                if escaped: escaped = False
                elif char == "\\": escaped = True
                elif char == quote: quote = None
                continue
            if char in ('"', "'"):
                quote = char
            elif char in "([{":
                stack.append(char)
            elif char in ")]}":
                if stack and stack[-1] == matching[char]: stack.pop()
            elif char == "," and not stack:
                args.append(source[start:i].strip()); start = i + 1
        tail = source[start:].strip()
        if tail or source.strip(): args.append(tail)
        return args

    @staticmethod
    def command_parts(line: str) -> tuple[str, str] | None:
        match = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*\[(.*)\]\s*$", line, re.S)
        if not match: return None
        return match.group(1).upper(), match.group(2).strip()

    @staticmethod
    def _block_start(line: str) -> str | None:
        s = line.strip().upper()
        for name in ("IF", "WHILE", "FOR", "FOREACH", "FUNCTION", "TRY"):
            if s == name or s.startswith(name + "["):
                return name
        return None

    @staticmethod
    def _block_end(name: str) -> str:
        return {"IF": "ENDIF", "WHILE": "ENDWHILE", "FOR": "ENDFOR", "FOREACH": "ENDFOREACH", "FUNCTION": "ENDFUNCTION", "TRY": "ENDTRY"}[name]

    @staticmethod
    def _line_command_name(line: str) -> str:
        s = line.strip().upper()
        parts = EasyScriptRuntime.command_parts(s)
        return parts[0] if parts else s.split(maxsplit=1)[0] if s else ""

    def find_block(self, lines: list[str], start: int, end: int, wanted: str, clauses: set[str] | None = None) -> tuple[list[tuple[int, str]], int]:
        """Find top-level block clauses and matching end, respecting nested blocks."""
        stack = [self._block_end(wanted)]
        found: list[tuple[int, str]] = []
        clauses = clauses or set()
        for i in range(start + 1, end):
            name = self._line_command_name(lines[i])
            opener = self._block_start(lines[i])
            if opener:
                stack.append(self._block_end(opener))
                continue
            if name in {"ENDIF", "ENDWHILE", "ENDFOR", "ENDFOREACH", "ENDFUNCTION", "ENDTRY"}:
                if stack and name == stack[-1]:
                    stack.pop()
                    if not stack:
                        return found, i
                continue
            if len(stack) == 1 and name in clauses:
                found.append((i, name))
        raise EasyScriptError(f"Block {wanted} on line {start + 1} has no closing {self._block_end(wanted)}")

    def execute_range(self, lines: list[str], start: int = 0, end: int | None = None) -> None:
        if end is None: end = len(lines)
        i = start
        while i < end:
            raw = lines[i]
            line_no = i + 1
            line = raw.strip()
            if not line or line.startswith("#") or line.upper().startswith("REM "):
                i += 1; continue
            name = self._line_command_name(line)
            try:
                if name == "IF":
                    clauses, close = self.find_block(lines, i, end, "IF", {"ELIF", "ELSE"})
                    branches = [(i, "IF")] + clauses
                    chosen: tuple[int, int] | None = None
                    for j, (clause_i, clause_name) in enumerate(branches):
                        stop = branches[j + 1][0] if j + 1 < len(branches) else close
                        if clause_name == "ELSE":
                            chosen = (clause_i + 1, stop); break
                        clause_line = lines[clause_i].strip()
                        condition = self._bracket_content(clause_line, clause_name)
                        if bool(self.eval_expr(condition)):
                            chosen = (clause_i + 1, stop); break
                    if chosen: self.execute_range(lines, chosen[0], chosen[1])
                    i = close + 1; continue
                if name == "WHILE":
                    _, close = self.find_block(lines, i, end, "WHILE")
                    condition = self._bracket_content(line, "WHILE")
                    body = lines[i + 1:close]
                    count = 0
                    while self.eval_expr(condition):
                        count += 1
                        if count > self.loop_limit: raise EasyScriptError("WHILE is gestopt: luslimiet bereikt")
                        try: self.execute_range(body, 0, len(body))
                        except ContinueSignal: continue
                        except BreakSignal: break
                    i = close + 1; continue
                if name == "FOR":
                    _, close = self.find_block(lines, i, end, "FOR")
                    args = self.split_args(self._bracket_content(line, "FOR"))
                    if len(args) not in (2, 3, 4): raise EasyScriptError("Use FOR[variable, count] or FOR[variable, start, stop, step]")
                    variable = args[0].strip()
                    values = self.eval_expr(args[1]) if len(args) == 2 else None
                    if len(args) == 2:
                        if isinstance(values, int): values = range(values)
                        try: iterator = iter(values)
                        except TypeError as exc: raise EasyScriptError("FOR expects a number or iterable list") from exc
                    else:
                        first, stop = int(self.eval_expr(args[1])), int(self.eval_expr(args[2]))
                        step = int(self.eval_expr(args[3])) if len(args) == 4 else 1
                        if step == 0: raise EasyScriptError("FOR-stap mag niet nul zijn")
                        iterator = iter(range(first, stop, step))
                    body = lines[i + 1:close]
                    for value in iterator:
                        self.set_var(variable, value)
                        try: self.execute_range(body, 0, len(body))
                        except ContinueSignal: continue
                        except BreakSignal: break
                    i = close + 1; continue
                if name == "FOREACH":
                    _, close = self.find_block(lines, i, end, "FOREACH")
                    args = self.split_args(self._bracket_content(line, "FOREACH"))
                    if len(args) != 2: raise EasyScriptError("Use FOREACH[variable, list]")
                    var = args[0].strip(); values = self.eval_expr(args[1])
                    body = lines[i + 1:close]
                    for value in values:
                        self.set_var(var, value)
                        try: self.execute_range(body, 0, len(body))
                        except ContinueSignal: continue
                        except BreakSignal: break
                    i = close + 1; continue
                if name == "FUNCTION":
                    _, close = self.find_block(lines, i, end, "FUNCTION")
                    args = self.split_args(self._bracket_content(line, "FUNCTION"))
                    if not args or not args[0]: raise EasyScriptError("Use FUNCTION[name, parameter1, parameter2]")
                    fn_name = args[0].strip()
                    params: list[str] = []
                    defaults: dict[str, Any] = {}
                    saw_default = False
                    for raw_param in args[1:]:
                        if not raw_param: continue
                        if "=" in raw_param:
                            param, default_source = raw_param.split("=", 1)
                            param = param.strip()
                            if not default_source.strip(): raise EasyScriptError(f"No default value for parameter {param}")
                            defaults[param] = self.eval_expr(default_source.strip())
                            saw_default = True
                        else:
                            param = raw_param.strip()
                            if saw_default: raise EasyScriptError("Parameters without default values must come before parameters with defaults")
                        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", param): raise EasyScriptError("Invalid function name or parameter")
                        if param in params: raise EasyScriptError(f"Dubbele parameter: {param}")
                        params.append(param)
                    self.functions[fn_name] = EasyFunction(fn_name, params, defaults, lines[i + 1:close])
                    i = close + 1; continue
                if name == "TRY":
                    clauses, close = self.find_block(lines, i, end, "TRY", {"CATCH", "FINALLY"})
                    catch_i = next((ci for ci, cn in clauses if cn == "CATCH"), None)
                    finally_i = next((ci for ci, cn in clauses if cn == "FINALLY"), None)
                    try_end = min([x for x in (catch_i, finally_i, close) if x is not None])
                    self.try_depth += 1
                    try:
                        try:
                            self.execute_range(lines, i + 1, try_end)
                        except (BreakSignal, ContinueSignal, ReturnSignal):
                            raise
                        except Exception as exc:
                            if catch_i is None: raise
                            catch_end = finally_i if finally_i is not None and finally_i > catch_i else close
                            cargs = self.split_args(self._bracket_content(lines[catch_i].strip(), "CATCH")) if "[" in lines[catch_i] else []
                            if cargs and cargs[0]: self.set_var(cargs[0].strip(), str(exc))
                            self.execute_range(lines, catch_i + 1, catch_end)
                    finally:
                        self.try_depth -= 1
                        if finally_i is not None:
                            self.execute_range(lines, finally_i + 1, close)
                    i = close + 1; continue

                self.execute_statement(line, line_no)
                i += 1
            except (BreakSignal, ContinueSignal, ReturnSignal):
                raise
            except Exception as exc:
                if self.try_depth == 0:
                    print(f"{RED}[EasyScript regel {line_no}] {exc}{RESET}")
                raise

    @staticmethod
    def _bracket_content(line: str, expected: str | None = None) -> str:
        m = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*\[(.*)\]\s*:?\s*$", line, re.S)
        if not m: raise EasyScriptError(f"Ongeldige syntax: {line}")
        if expected and m.group(1).upper() != expected.upper(): raise EasyScriptError(f"Verwacht {expected}[...]")
        return m.group(2).strip()

    def eval_legacy_value(self, text: str) -> Any:
        text = text.strip()
        if text in self.variables: return self.variables[text]
        if self.scopes and text in self.scopes[-1]: return self.scopes[-1][text]
        try:
            return self.eval_expr(text)
        except Exception:
            if len(text) >= 2 and text[0] == text[-1] and text[0] in ('"', "'"):
                return _decode_string(text)
            # Bare unquoted text is accepted by older EasyScript commands. Do not
            # swallow real expression errors such as division by zero or bad indexes.
            looks_like_expression = (
                any(op in text for op in ("==", "!=", "<=", ">=", "**", "//", "+", "*", "/", "%", "<", ">", "[", "]", "(", ")"))
                or bool(re.search(r"\b(and|or|not|in)\b", text, re.I))
            )
            if looks_like_expression:
                raise
            return text

    def execute_statement(self, line: str, line_no: int = 0) -> bool:
        upper = line.upper().strip()
        if upper in ("BREAK", "STOPLOOP"):
            raise BreakSignal()
        if upper in ("CONTINUE", "NEXTITERATION"):
            raise ContinueSignal()
        if upper in ("RETURN", "RETURN[]"):
            raise ReturnSignal(None)
        if upper.startswith("RETURN[") and line.endswith("]"):
            raise ReturnSignal(self.eval_expr(self._bracket_content(line, "RETURN")))
        if upper in ("CLEAR", "CLS"):
            os.system("cls" if os.name == "nt" else "clear"); return True
        if upper == "HELP": self.print_help(); return True
        if upper == "VARS":
            print(f"\n{YELLOW}--- ACTIEVE VARIABELEN ---{RESET}")
            combined = dict(self.variables)
            if self.scopes: combined.update(self.scopes[-1])
            for key, value in combined.items(): print(f"  {CYAN}{key}{RESET} = {GREEN}{value!r}{RESET}")
            if not combined: print("  (Geen variabelen ingesteld)")
            print(f"{YELLOW}--------------------------{RESET}\n"); return True
        if upper in ("IPCONFIG", "WHOAMI", "TIME", "DATE", "SYSINFO", "DIR"):
            return self.execute_system_command(upper)
        if upper in ("ELSE", "ENDIF", "ENDWHILE", "ENDFOR", "ENDFOREACH", "ENDFUNCTION", "ENDTRY", "FINALLY") or upper.startswith("ELIF[") or upper.startswith("CATCH["):
            raise EasyScriptError(f"{upper} may only appear inside its matching block")

        # Indexed assignment: list[0] = value or dictionary["key"] = value.
        indexed_assignment = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*\[(.+)\]\s*(\+=|-=|\*=|/=|%=|=)\s*(.*?)\s*$", line, re.S)
        if indexed_assignment:
            root_name, index_source, operator, expression = indexed_assignment.groups()
            target = self.resolve_name(root_name)
            key = self.eval_expr(index_source)
            value = self.eval_legacy_value(expression)
            if operator != "=":
                value = ExpressionParser.apply_operator(operator[:-1], target[key], value)
            target[key] = value
            return True

        # Variable assignment and update: x = expression, x += expression, etc.
        assignment = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*(\+=|-=|\*=|/=|%=|=)\s*(.*?)\s*$", line, re.S)
        if assignment and not upper.startswith(("IF[", "WHILE[", "FOR[", "FOREACH[", "FUNCTION[")):
            name, operator, expression = assignment.groups()
            expression = expression[:-1].rstrip() if expression.endswith(":") and "INPUT[" in expression.upper() else expression
            if expression.upper().startswith("INPUT["):
                prompt = self._bracket_content(expression, "INPUT")
                val = input(str(self.eval_legacy_value(prompt)) + " ")
            elif expression.upper().startswith("READ["):
                filename = self._bracket_content(expression, "READ").strip('"').strip("'")
                with open(self.resolve_path(filename), "r", encoding="utf-8") as handle: val = handle.read()
            else:
                val = self.eval_legacy_value(expression)
            if operator != "=":
                current = self.resolve_name(name)
                symbol = operator[:-1]
                val = ExpressionParser.apply_operator(symbol, current, val)
            self.set_var(name, val); return True

        parts = self.command_parts(line)
        if parts:
            cmd, content = parts
            args = self.split_args(content)
            if cmd in ("DNS", "DNS_LOOKUP"):
                host = self.eval_legacy_value(content)
                print(self._dns_lookup(host)); return True
            if cmd == "TCP_CHECK":
                if len(args) not in (2, 3): raise EasyScriptError("Use TCP_CHECK[host, port, timeout]")
                values = [self.eval_legacy_value(a) for a in args]
                print(self._tcp_check(*values)); return True
            if cmd == "HTTP_GET":
                if len(args) not in (1, 2, 3): raise EasyScriptError("Use HTTP_GET[url, timeout, headers]")
                values = [self.eval_legacy_value(a) for a in args]
                print(self._http_get(*values)); return True
            if cmd == "HTTP_POST":
                if len(args) < 2 or len(args) > 5: raise EasyScriptError("Use HTTP_POST[url, body, content_type, timeout, headers]")
                values = [self.eval_legacy_value(a) for a in args]
                print(json.dumps(self._http_post(*values), ensure_ascii=False, indent=2)); return True
            if cmd == "HTTP_REQUEST":
                if len(args) < 1 or len(args) > 5: raise EasyScriptError("Use HTTP_REQUEST[url, method, body, headers, timeout]")
                values = [self.eval_legacy_value(a) for a in args]
                print(json.dumps(self._http_request(*values), ensure_ascii=False, indent=2)); return True
            if cmd == "TEXT":
                try:
                    value = self.eval_expr(content)
                except Exception:
                    # Version 2.x also allowed unquoted pieces joined with +, e.g. TEXT[Hello + name].
                    chunks = self._split_top_level_plus(content)
                    if len(chunks) > 1:
                        value = "".join(str(self.eval_legacy_value(chunk)) for chunk in chunks)
                    else:
                        value = self.eval_legacy_value(content)
                print(value); return True
            if cmd == "EVAL":
                # Kept for compatibility, but expressions are EasyScript only (never Python eval).
                print(self.eval_expr(content)); return True
            if cmd == "LEN": print(len(self.eval_legacy_value(content))); return True
            if cmd == "UPPER": print(str(self.eval_legacy_value(content)).upper()); return True
            if cmd == "LOWER": print(str(self.eval_legacy_value(content)).lower()); return True
            if cmd == "ABS": print(abs(float(self.eval_legacy_value(content)))); return True
            if cmd == "ROUND": print(round(float(self.eval_legacy_value(content)))); return True
            if cmd == "RANDOM":
                if len(args) == 2: print(random.randint(int(self.eval_legacy_value(args[0])), int(self.eval_legacy_value(args[1]))))
                else: print(random.randint(0, 100))
                return True
            if cmd in ("DEL", "DELETE"):
                filename = content.strip().strip('"').strip("'"); path = self.resolve_path(filename)
                if os.path.exists(path): os.remove(path); print(f"{GREEN}[DELETED]: {filename}{RESET}")
                else: print(f"{RED}[ERROR] File {filename!r} not found.{RESET}")
                return True
            if cmd == "MKDIR":
                path = self.resolve_path(content.strip().strip('"').strip("'")); os.makedirs(path, exist_ok=True); print(f"{GREEN}[FOLDER CREATED]: {path}{RESET}"); return True
            if cmd == "READ":
                filename = content.strip().strip('"').strip("'"); path = self.resolve_path(filename)
                with open(path, "r", encoding="utf-8") as handle: print(handle.read().rstrip("\n"))
                return True
            if cmd == "WRITE": return self._write_command(args, content, line_no)
            if cmd == "RUN":
                filename = content.strip().strip('"').strip("'"); path = self.resolve_path(filename)
                with open(path, "r", encoding="utf-8") as handle: self.run_script(handle.readlines())
                return True
            if cmd == "TYPE":
                if PYAUTOGUI_AVAILABLE: pyautogui.write(str(self.eval_legacy_value(content.strip().strip('"').strip("'"))), interval=0.02)
                else: print(f"{YELLOW}[WAARSCHUWING] PyAutoGUI is niet geïnstalleerd.{RESET}")
                return True
            if cmd == "PRESS":
                if PYAUTOGUI_AVAILABLE: pyautogui.press(str(self.eval_legacy_value(content.strip().strip('"').strip("'")).lower()))
                else: print(f"{YELLOW}[WAARSCHUWING] PyAutoGUI is niet geïnstalleerd.{RESET}")
                return True
            if cmd == "CMD":
                command = content.strip().strip('"').strip("'")
                print(f"{GREEN}[CMD]: {command}{RESET}"); subprocess.Popen(command, shell=True); return True
            if cmd == "PING":
                host = str(self.eval_legacy_value(content.strip().strip('"').strip("'")))
                param = "-n" if os.name == "nt" else "-c"
                subprocess.run(["ping", param, "2", host], check=False); return True
            if cmd == "SLEEP": time.sleep(float(self.eval_legacy_value(content))); return True
            if cmd == "DELVAR":
                name = content.strip()
                scope = self.scopes[-1] if self.scopes and name in self.scopes[-1] else self.variables
                if name not in scope: raise EasyScriptError(f"Onbekende variabele: {name}")
                del scope[name]; return True
            if cmd == "SETITEM":
                if len(args) != 3: raise EasyScriptError("Use SETITEM[collection, key, value]")
                self._set_item(self.eval_legacy_value(args[0]), self.eval_legacy_value(args[1]), self.eval_legacy_value(args[2])); return True
            if cmd == "DELITEM":
                if len(args) != 2: raise EasyScriptError("Use DELITEM[collection, key]")
                self._delete_item(self.eval_legacy_value(args[0]), self.eval_legacy_value(args[1])); return True
            if cmd == "SET":
                if len(args) != 2: raise EasyScriptError("Use SET[name, value]")
                self.set_var(args[0].strip(), self.eval_legacy_value(args[1])); return True
            if cmd == "GET": print(self.resolve_name(content.strip())); return True
            if cmd == "APPEND":
                if len(args) != 2: raise EasyScriptError("Use APPEND[list, value]")
                self._append(self.eval_legacy_value(args[0]), self.eval_legacy_value(args[1])); return True
            if cmd == "INSERT":
                if len(args) != 3: raise EasyScriptError("Use INSERT[list, position, value]")
                self._insert(self.eval_legacy_value(args[0]), self.eval_legacy_value(args[1]), self.eval_legacy_value(args[2])); return True
            if cmd == "POP":
                values = [self.eval_legacy_value(a) for a in args]; print(self._pop(*values)); return True
            if cmd == "REMOVE":
                if len(args) != 2: raise EasyScriptError("Use REMOVE[list, value]")
                self._remove(self.eval_legacy_value(args[0]), self.eval_legacy_value(args[1])); return True
            if cmd == "SORT":
                values = self.eval_legacy_value(content)
                values.sort(); print(values); return True
            if cmd == "REVERSE":
                values = self.eval_legacy_value(content)
                values.reverse(); print(values); return True
            if cmd == "JSON":
                if not args: raise EasyScriptError("Use JSON[value] or JSON[value, pretty]")
                value = self.eval_legacy_value(args[0]); pretty = bool(self.eval_legacy_value(args[1])) if len(args) > 1 else False
                print(json.dumps(value, ensure_ascii=False, indent=2 if pretty else None)); return True
            if cmd == "ASSERT":
                if not args: raise EasyScriptError("Use ASSERT[condition, message]")
                if not self.eval_expr(args[0]): raise EasyScriptError(str(self.eval_legacy_value(args[1])) if len(args) > 1 else "ASSERT failed")
                return True
            if cmd == "RAISE": raise EasyScriptError(str(self.eval_legacy_value(content)))
            if cmd == "REMOTE_SERVER":
                if len(args) not in (2, 3):
                    raise EasyScriptError('Use REMOTE_SERVER[port, "long-secret", "shared_folder"]')
                port = int(self.eval_legacy_value(args[0]))
                token = str(self.eval_legacy_value(args[1]))
                folder = str(self.eval_legacy_value(args[2])) if len(args) == 3 else "EasyShared"
                self.start_remote_file_server(port, token, folder)
                return True
            if cmd == "REMOTE_LIST":
                if len(args) not in (2, 3): raise EasyScriptError('Use REMOTE_LIST["ip:port", "secret", "folder"]')
                host = str(self.eval_legacy_value(args[0])); token = str(self.eval_legacy_value(args[1]))
                folder = str(self.eval_legacy_value(args[2])) if len(args) == 3 else ""
                print(json.dumps(self.remote_file_request(host, token, "LIST", folder), ensure_ascii=False, indent=2)); return True
            if cmd == "REMOTE_READ":
                if len(args) != 3: raise EasyScriptError('Use REMOTE_READ["ip:port", "secret", "file.easy"]')
                host, token, filename = [str(self.eval_legacy_value(a)) for a in args]
                print(self.remote_file_request(host, token, "READ", filename)); return True
            if cmd == "REMOTE_WRITE":
                if len(args) != 4: raise EasyScriptError('Use REMOTE_WRITE["ip:port", "secret", "file.easy", content]')
                host, token, filename = [str(self.eval_legacy_value(a)) for a in args[:3]]
                content = str(self.eval_legacy_value(args[3]))
                result = self.remote_file_request(host, token, "WRITE", filename, content)
                print(f"{GREEN}[REMOTE WRITE] {result.get('message', 'File saved')}{RESET}"); return True
            if cmd == "REMOTE_EDIT":
                if len(args) not in (3, 4): raise EasyScriptError('Use REMOTE_EDIT["ip:port", "secret", "file.easy", "local_copy.easy"]')
                host, token, filename = [str(self.eval_legacy_value(a)) for a in args[:3]]
                local_filename = str(self.eval_legacy_value(args[3])) if len(args) == 4 else None
                self.remote_edit_file(host, token, filename, local_filename); return True
            if cmd == "SERVER":
                port = int(self.eval_legacy_value(content)); t = threading.Thread(target=self.start_target_server, args=(port,), daemon=True); t.start(); return True
            if cmd == "SEND":
                if len(args) >= 2: self.send_to_target(str(self.eval_legacy_value(args[0])), str(self.eval_legacy_value(",".join(args[1:]))))
                else: raise EasyScriptError("Use SEND[ip:port, command]")
                return True

        # DuckyScript commands (kept for existing .txt/.duck scripts).
        if self.execute_duckscript_line(line, line_no): return True
        raise EasyScriptError(f"Unknown Command: {line}")

    @staticmethod
    def _split_top_level_plus(source: str) -> list[str]:
        pieces, start = [], 0
        stack: list[str] = []
        quote: str | None = None
        escaped = False
        matching = {")": "(", "]": "[", "}": "{"}
        for i, char in enumerate(source):
            if quote:
                if escaped: escaped = False
                elif char == "\\": escaped = True
                elif char == quote: quote = None
                continue
            if char in ('\"', "'"): quote = char
            elif char in "([{": stack.append(char)
            elif char in ")] }".replace(" ", ""):
                if stack and stack[-1] == matching[char]: stack.pop()
            elif char == "+" and not stack:
                pieces.append(source[start:i].strip()); start = i + 1
        pieces.append(source[start:].strip())
        return pieces

    def _write_command(self, args: list[str], original: str, line_no: int) -> bool:
        if len(args) == 3:
            filename = str(self.eval_legacy_value(args[0])).strip('"').strip("'")
            mode = args[1].strip()
            value = str(self.eval_legacy_value(args[2]))
            path = self.resolve_path(filename)
            existing = []
            if os.path.exists(path):
                with open(path, "r", encoding="utf-8") as handle: existing = [x.rstrip("\n") for x in handle.readlines()]
            if mode == "+": existing.append(value)
            elif re.fullmatch(r"-\d+", mode):
                index = abs(int(mode)) - 1
                while len(existing) <= index: existing.append("")
                existing[index] = value
            else: raise EasyScriptError(f"Invalid WRITE mode: {mode}. Use + or a value such as -1")
            with open(path, "w", encoding="utf-8") as handle: handle.write("\n".join(existing) + ("\n" if existing else ""))
            print(f"{GREEN}[WRITE] Saved: {filename}{RESET}"); return True
        if len(args) == 2:
            filename = str(self.eval_legacy_value(args[0])).strip('"').strip("'")
            action = args[1].strip().strip('"').strip("'")
            path = self.resolve_path(filename)
            if action.lower() == "-showall":
                with open(path, "r", encoding="utf-8") as handle:
                    print(f"\n{YELLOW}--- INHOUD: {filename} ---{RESET}")
                    for idx, line in enumerate(handle, 1): print(f"{CYAN}[{idx}]{RESET} {line.rstrip()}")
                return True
            with open(path, "w", encoding="utf-8") as handle: handle.write(str(self.eval_legacy_value(args[1])) + "\n")
            print(f"{GREEN}[WRITE] File overwritten: {filename}{RESET}"); return True
        raise EasyScriptError("Use WRITE[file, text], WRITE[file, +, text], or WRITE[file, -1, text]")

    def execute_system_command(self, command: str) -> bool:
        if command == "IPCONFIG":
            program = "ipconfig" if os.name == "nt" else "ifconfig"
            if os.name != "nt" and shutil.which(program) is None and shutil.which("ip"):
                program = "ip"
                subprocess.run([program, "addr"], check=False)
            else: subprocess.run(program, shell=True, check=False)
        elif command == "WHOAMI": print(f"Current User: {CYAN}{getpass.getuser()}{RESET}")
        elif command == "TIME": print(f"Current Time: {CYAN}{_datetime.datetime.now().strftime('%H:%M:%S')}{RESET}")
        elif command == "DATE": print(f"Current Date: {CYAN}{_datetime.date.today().isoformat()}{RESET}")
        elif command == "SYSINFO":
            print(f"\n{YELLOW}--- SYSTEEMINFORMATIE ---{RESET}")
            print(f"  OS         : {platform.system()} {platform.release()}")
            print(f"  Machine    : {platform.machine()}")
            print(f"  Processor  : {platform.processor()}")
            print(f"  Runtime    : EasyScript 1.0.3")
            print(f"{YELLOW}-------------------------{RESET}\n")
        elif command == "DIR":
            print(f"\n{YELLOW}--- FILES IN {self.script_dir} ---{RESET}")
            for filename in os.listdir(self.script_dir): print(f"  {CYAN}{filename}{RESET}")
        return True

    def execute_duckscript_line(self, line: str, line_no: int = 0) -> bool:
        parts = line.split(maxsplit=1)
        cmd = parts[0].upper() if parts else ""
        arg = parts[1].strip() if len(parts) > 1 else ""
        valid = {"STRING", "DELAY", "REM", "#", "ENTER", "TAB", "SPACE", "ESCAPE", "BACKSPACE", "DELETE", "UP", "DOWN", "LEFT", "RIGHT", "HOME", "END", "GUI", "WINDOWS", "CTRL", "CONTROL", "ALT", "SHIFT"}
        if cmd not in valid: return False
        if cmd in ("REM", "#"): return True
        if not PYAUTOGUI_AVAILABLE:
            if cmd != "DELAY": print(f"{YELLOW}[WAARSCHUWING regel {line_no}] PyAutoGUI ontbreekt; toetsen worden niet verstuurd.{RESET}")
            if cmd == "DELAY":
                try: time.sleep(float(arg) / 1000.0)
                except ValueError: raise EasyScriptError(f"Invalid DELAY value: {arg}")
            return True
        if cmd == "STRING": pyautogui.write(arg, interval=0.02)
        elif cmd == "DELAY":
            try: time.sleep(float(arg) / 1000.0)
            except ValueError: raise EasyScriptError(f"Invalid DELAY value: {arg}")
        elif cmd in {"ENTER", "TAB", "SPACE", "ESCAPE", "BACKSPACE", "DELETE", "UP", "DOWN", "LEFT", "RIGHT", "HOME", "END"}:
            pyautogui.press(cmd.lower())
        else:
            key_map = {"gui": "win", "windows": "win", "ctrl": "ctrl", "control": "ctrl", "alt": "alt", "shift": "shift"}
            main_key = key_map.get(cmd.lower(), cmd.lower())
            if arg: pyautogui.hotkey(main_key, *[key_map.get(p.lower(), p.lower()) for p in arg.split()])
            else: pyautogui.press(main_key)
        return True

    # Compatibility with the older TCP controller/target commands.
    def start_target_server(self, port: int) -> None:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as server:
            server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            server.bind(("0.0.0.0", int(port))); server.listen(1)
            print(f"\n{GREEN}[TARGET ACTIVE] Poort {port} luistert op opdrachten...{RESET}")
            while True:
                client, _addr = server.accept()
                with client:
                    data = client.recv(4096).decode("utf-8", errors="replace")
                if data.strip():
                    try: self.execute_statement(data.strip(), 0)
                    except Exception as exc: print(f"{RED}[SERVER ERROR] {exc}{RESET}")

    @staticmethod
    def send_to_target(target_info: str, command: str) -> None:
        try:
            ip, port_text = target_info.split(":", 1)
            with socket.create_connection((ip.strip(), int(port_text.strip())), timeout=5) as conn:
                conn.sendall(command.encode("utf-8"))
            print(f"{GREEN}[CONTROLLER] Opdracht verzonden.{RESET}")
        except Exception as exc:
            print(f"{RED}[NETWORK ERROR] Connection failed: {exc}{RESET}")

    # Authenticated, restricted remote .easy-file service. It never executes received code.
    _REMOTE_MAX_BYTES = 1_500_000

    @staticmethod
    def _remote_read_exact(reader, size: int) -> bytes:
        data = reader.read(size)
        if len(data) != size:
            raise EasyScriptError("Onvolledig netwerkantwoord ontvangen")
        return data

    @staticmethod
    def _validate_remote_relative_path(relative: str, need_easy_file: bool = False) -> str:
        relative = str(relative).replace("\\", "/")
        pure = Path(relative)
        parts = relative.split("/")
        if not relative or relative.startswith("/") or pure.is_absolute() or any(part in ("..", "") for part in parts):
            if relative not in ("", "."):
                raise EasyScriptError("Use a relative path inside the shared folder; '..' is not allowed")
        if relative in ("", "."):
            if need_easy_file:
                raise EasyScriptError("Provide a filename with the .easy extension")
            return ""
        if need_easy_file and not relative.lower().endswith(".easy"):
            raise EasyScriptError("Only .easy files can be read or modified remotely")
        return "/".join(part for part in parts if part not in ("", "."))

    @staticmethod
    def _remote_inside_root(root: Path, relative: str) -> Path:
        candidate = (root / Path(*relative.split("/"))).resolve() if relative else root.resolve()
        resolved_root = root.resolve()
        if candidate != resolved_root and resolved_root not in candidate.parents:
            raise EasyScriptError("This path is outside the shared folder")
        return candidate

    def start_remote_file_server(self, port: int, token: str, folder: str = "EasyShared") -> None:
        if len(token) < 16:
            raise EasyScriptError("Use a secret of at least 16 characters with REMOTE_SERVER")
        if not 1 <= int(port) <= 65535:
            raise EasyScriptError("Poort moet tussen 1 en 65535 liggen")
        root = Path(self.resolve_path(folder)).resolve()
        root.mkdir(parents=True, exist_ok=True)
        if self.remote_server_started:
            raise EasyScriptError("The EasyScript file server is already running in this process")
        self.remote_server_started = True
        thread = threading.Thread(target=self._remote_file_server, args=(int(port), token, root), daemon=True)
        thread.start()
        print(f"{GREEN}[REMOTE FILE SERVER] Shared .easy folder: {root}; poort: {port}{RESET}")
        print(f"{YELLOW}Use only on a trusted local network; do not configure port forwarding.{RESET}")

    def _remote_file_server(self, port: int, token: str, root: Path) -> None:
        seen_nonces: dict[str, int] = {}
        nonce_lock = threading.Lock()
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as server:
            server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                server.bind(("0.0.0.0", port))
                server.listen(8)
                server.settimeout(1.0)
            except OSError as exc:
                print(f"{RED}[REMOTE FILE SERVER] Could not start: {exc}{RESET}")
                self.remote_server_started = False
                return
            while True:
                try:
                    client, address = server.accept()
                except socket.timeout:
                    continue
                except OSError as exc:
                    print(f"{RED}[REMOTE FILE SERVER] Network error: {exc}{RESET}")
                    continue
                with client:
                    try:
                        client.settimeout(10)
                        reader = client.makefile("rb")
                        writer = client.makefile("wb")
                        try:
                            raw = reader.readline(self._REMOTE_MAX_BYTES + 16_384)
                            if not raw or len(raw) > self._REMOTE_MAX_BYTES + 16_384 or not raw.endswith(b"\n"):
                                raise EasyScriptError("Invalid or oversized request")
                            request = json.loads(raw.decode("utf-8"))
                            if not isinstance(request, dict):
                                raise EasyScriptError("Invalid request")
                            signature = str(request.get("signature", ""))
                            body = {key: request.get(key) for key in ("method", "path", "data", "timestamp", "nonce")}
                            canonical = json.dumps(body, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
                            expected = hmac.new(token.encode("utf-8"), canonical, "sha256").hexdigest()
                            if not hmac.compare_digest(signature, expected):
                                raise EasyScriptError("Authentication failed: check the shared secret")
                            timestamp = int(body.get("timestamp", 0))
                            nonce = str(body.get("nonce", ""))
                            if abs(int(time.time()) - timestamp) > 90 or len(nonce) < 16:
                                raise EasyScriptError("Request expired; check the date and time on both PCs")
                            with nonce_lock:
                                cutoff = int(time.time()) - 120
                                for old_nonce in [n for n, ts in seen_nonces.items() if ts < cutoff]:
                                    seen_nonces.pop(old_nonce, None)
                                if nonce in seen_nonces:
                                    raise EasyScriptError("Duplicate network request rejected")
                                seen_nonces[nonce] = timestamp

                            method = str(body.get("method", "")).upper()
                            relative = self._validate_remote_relative_path(str(body.get("path") or ""), method in ("READ", "WRITE"))
                            if method == "LIST":
                                directory = self._remote_inside_root(root, relative)
                                if not directory.is_dir():
                                    raise EasyScriptError("The requested folder does not exist")
                                entries = []
                                for child in sorted(directory.iterdir(), key=lambda item: item.name.lower()):
                                    try:
                                        safe_child = child.resolve()
                                        if safe_child != root and root not in safe_child.parents:
                                            continue
                                    except OSError:
                                        continue
                                    if child.is_dir():
                                        entries.append({"name": child.name, "type": "directory"})
                                    elif child.is_file() and child.suffix.lower() == ".easy":
                                        entries.append({"name": child.name, "type": "file"})
                                response = {"ok": True, "data": entries}
                            elif method == "READ":
                                path = self._remote_inside_root(root, relative)
                                if not path.is_file():
                                    raise EasyScriptError("The .easy file does not exist")
                                content = path.read_text(encoding="utf-8")
                                if len(content.encode("utf-8")) > self._REMOTE_MAX_BYTES:
                                    raise EasyScriptError("This file exceeds the allowed size limit")
                                response = {"ok": True, "data": content}
                            elif method == "WRITE":
                                path = self._remote_inside_root(root, relative)
                                content = body.get("data")
                                if not isinstance(content, str):
                                    raise EasyScriptError("File content must be text")
                                encoded = content.encode("utf-8")
                                if len(encoded) > self._REMOTE_MAX_BYTES:
                                    raise EasyScriptError("File is too large (maximum 1.5 MB)")
                                path.parent.mkdir(parents=True, exist_ok=True)
                                if path.exists():
                                    if not path.is_file():
                                        raise EasyScriptError("Target is not a file")
                                    shutil.copy2(path, path.with_suffix(path.suffix + ".bak"))
                                temp_path = path.with_name(path.name + ".tmp-" + secrets.token_hex(6))
                                try:
                                    temp_path.write_bytes(encoded)
                                    os.replace(temp_path, path)
                                finally:
                                    try: temp_path.unlink(missing_ok=True)
                                    except OSError: pass
                                response = {"ok": True, "data": {"message": f"{relative} saved on the server"}}
                            else:
                                raise EasyScriptError("Unsupported file action")
                        finally:
                            try: reader.close()
                            except Exception: pass
                        writer.write((json.dumps(response, ensure_ascii=False) + "\n").encode("utf-8"))
                        writer.flush()
                        writer.close()
                    except Exception as exc:
                        try:
                            payload = {"ok": False, "error": str(exc) if isinstance(exc, EasyScriptError) else "Invalid request or server error"}
                            client.sendall((json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8"))
                        except Exception:
                            pass
                        if not isinstance(exc, (EasyScriptError, json.JSONDecodeError, UnicodeDecodeError, OSError, ValueError, TypeError)):
                            print(f"{RED}[REMOTE FILE SERVER] Error from {address[0]}: {exc}{RESET}")

    def remote_file_request(self, target_info: str, token: str, method: str, path: str = "", data: Any = None) -> Any:
        if len(token) < 16:
            raise EasyScriptError("The shared secret must be at least 16 characters long")
        try:
            host, port_text = target_info.rsplit(":", 1)
            port = int(port_text)
        except (ValueError, AttributeError) as exc:
            raise EasyScriptError('Doel moet de vorm "192.168.1.20:8765" hebben') from exc
        method = method.upper()
        checked_path = self._validate_remote_relative_path(path, method in ("READ", "WRITE"))
        body = {"method": method, "path": checked_path, "data": data, "timestamp": int(time.time()), "nonce": secrets.token_hex(16)}
        canonical = json.dumps(body, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
        request = dict(body, signature=hmac.new(token.encode("utf-8"), canonical, "sha256").hexdigest())
        payload = json.dumps(request, ensure_ascii=False).encode("utf-8") + b"\n"
        if len(payload) > self._REMOTE_MAX_BYTES + 16_384:
            raise EasyScriptError("Network request is too large")
        try:
            with socket.create_connection((host.strip(), port), timeout=10) as conn:
                conn.settimeout(15)
                conn.sendall(payload)
                with conn.makefile("rb") as reader:
                    raw = reader.readline(self._REMOTE_MAX_BYTES + 16_384)
            if not raw or not raw.endswith(b"\n"):
                raise EasyScriptError("Geen geldig antwoord van de externe pc ontvangen")
            response = json.loads(raw.decode("utf-8"))
        except EasyScriptError:
            raise
        except Exception as exc:
            raise EasyScriptError(f"Could not connect to {target_info}: {exc}") from exc
        if not response.get("ok"):
            raise EasyScriptError(str(response.get("error", "Remote request failed")))
        return response.get("data")

    def remote_edit_file(self, target_info: str, token: str, relative_filename: str, local_filename: str | None = None) -> None:
        relative = self._validate_remote_relative_path(relative_filename, need_easy_file=True)
        # Fetch the server's current version, then edit a matching local copy.
        remote_content = self.remote_file_request(target_info, token, "READ", relative)
        # By default keep the matching local copy under ./EasyShared/, mirroring the
        # default server root. An optional fourth argument lets users choose another
        # relative local .easy path.
        local_relative = self._validate_remote_relative_path(local_filename or ("EasyShared/" + relative), need_easy_file=True)
        local_path = self._remote_inside_root(Path(self.script_dir).resolve(), local_relative)
        local_path.parent.mkdir(parents=True, exist_ok=True)
        if local_path.exists():
            if not local_path.is_file():
                raise EasyScriptError("The local target is not a file")
            shutil.copy2(local_path, local_path.with_suffix(local_path.suffix + ".local.bak"))
        local_path.write_text(remote_content, encoding="utf-8")
        editor = os.environ.get("EASYSCRIPT_EDITOR") or os.environ.get("VISUAL") or os.environ.get("EDITOR")
        if editor:
            command = shlex.split(editor) + [str(local_path)]
        elif os.name == "nt":
            command = ["notepad.exe", str(local_path)]
        else:
            preferred = "nano" if shutil.which("nano") else "vi"
            command = [preferred, str(local_path)]
        print(f"{CYAN}[REMOTE EDIT] Lokale kopie openen: {local_path}{RESET}")
        print(f"{YELLOW}Sla je wijzigingen op en sluit de editor om ze naar beide pc's te sturen.{RESET}")
        try:
            subprocess.run(command, check=False)
        except OSError as exc:
            raise EasyScriptError(f"Could not start the editor ({exc}). Set EASYSCRIPT_EDITOR.") from exc
        edited_content = local_path.read_text(encoding="utf-8")
        result = self.remote_file_request(target_info, token, "WRITE", relative, edited_content)
        print(f"{GREEN}[REMOTE EDIT] File saved on this PC and the remote PC: {result['message']}{RESET}")

    def run_script(self, lines: list[str]) -> None:
        self.execute_range(lines, 0, len(lines))

