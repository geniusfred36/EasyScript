def main() -> int:
    script_path = os.path.abspath(sys.argv[0]) if sys.argv and os.path.isfile(sys.argv[0]) else __file__
    runtime = EasyScriptRuntime(script_path)
    print(f"{CYAN}EasyScript 3.2 — remote .easy editing, authenticated file server, networking, and DuckyScript{RESET}")
    if len(sys.argv) > 1:
        filename = runtime.resolve_path(sys.argv[1])
        if not os.path.isfile(filename):
            print(f"{RED}[ERROR] File not found: {filename}{RESET}"); return 2
        print(f"{YELLOW}Running script: {filename}{RESET}")
        try:
            with open(filename, "r", encoding="utf-8") as handle: runtime.run_script(handle.readlines())
        except Exception:
            traceback.print_exc(); return 1
        if runtime.remote_server_started:
            print(f"{GREEN}[REMOTE FILE SERVER] Draait op de achtergrond. Druk Ctrl+C om te stoppen.{RESET}")
            try:
                while runtime.remote_server_started: time.sleep(1)
            except KeyboardInterrupt:
                print(f"\n{YELLOW}Remote file server stopped.{RESET}")
        return 0
    print(f'Type {YELLOW}"HELP"{RESET} for help or {YELLOW}"EXIT"{RESET} to exit.\n')
    line_no = 1
    block_lines: list[str] = []
    block_stack: list[str] = []
    while True:
        try:
            prompt = "... " if block_lines else ">>> "
            line = input(f"{CYAN}{prompt}{RESET}")
            command = line.strip().upper()
            if command in ("EXIT", "QUIT") and not block_lines:
                print(f"{YELLOW}EasyScript closed. Goodbye!{RESET}"); break
            if not line.strip():
                if block_lines: block_lines.append(line)
                continue

            if not block_lines:
                opener = runtime._block_start(line)
                if opener:
                    block_lines.append(line)
                    block_stack.append(runtime._block_end(opener))
                    continue
                try:
                    runtime.execute_statement(line, line_no)
                    line_no += 1
                except (ReturnSignal, BreakSignal, ContinueSignal):
                    print(f"{RED}BREAK/CONTINUE/RETURN cannot be used here.{RESET}")
                except Exception as exc:
                    print(f"{RED}[ERROR] {exc}{RESET}")
                continue

            # Multiline blocks in the REPL use the same syntax as .easy files.
            block_lines.append(line)
            opener = runtime._block_start(line)
            if opener:
                block_stack.append(runtime._block_end(opener))
            else:
                end_name = runtime._line_command_name(line)
                if block_stack and end_name == block_stack[-1]:
                    block_stack.pop()
            if not block_stack:
                try:
                    runtime.run_script(block_lines)
                    line_no += len(block_lines)
                except (ReturnSignal, BreakSignal, ContinueSignal):
                    print(f"{RED}BREAK/CONTINUE/RETURN cannot be used outside a matching function or loop here.{RESET}")
                except Exception as exc:
                    print(f"{RED}[ERROR] {exc}{RESET}")
                block_lines = []
        except (KeyboardInterrupt, EOFError):
            print(f"\n{YELLOW}EasyScript closed.{RESET}"); break
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
