    @staticmethod
    def _dns_lookup(host: Any) -> list[str]:
        hostname = str(host).strip()
        if not hostname:
            raise EasyScriptError("DNS_LOOKUP expects a hostname or IP address")
        try:
            infos = socket.getaddrinfo(hostname, None, type=socket.SOCK_STREAM)
            return sorted({info[4][0] for info in infos})
        except OSError as exc:
            raise EasyScriptError(f"DNS lookup failed for {hostname!r}: {exc}") from exc

    @staticmethod
    def _local_ip(destination: Any = "1.1.1.1", port: Any = 53) -> str:
        """Return the local interface address selected for a route, without sending data."""
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            sock.connect((str(destination), int(port)))
            return str(sock.getsockname()[0])
        except OSError:
            return "127.0.0.1"
        finally:
            sock.close()

    @staticmethod
    def _tcp_check(host: Any, port: Any, timeout: Any = 3) -> bool:
        try:
            with socket.create_connection((str(host), int(port)), timeout=max(0.1, float(timeout))):
                return True
        except (OSError, ValueError, TypeError):
            return False

    @staticmethod
    def _http_request(url: Any, method: Any = "GET", body: Any = None, headers: Any = None, timeout: Any = 10) -> dict[str, Any]:
        url_text = str(url).strip()
        parsed = _urlparse.urlparse(url_text)
        if parsed.scheme.lower() not in {"http", "https"} or not parsed.netloc:
            raise EasyScriptError("HTTP_REQUEST verwacht een volledige http://- of https://-URL")
        method_text = str(method).upper().strip()
        if method_text not in {"GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"}:
            raise EasyScriptError("HTTP-methode moet GET, POST, PUT, PATCH, DELETE of HEAD zijn")
        header_dict = {str(k): str(v) for k, v in headers.items()} if isinstance(headers, dict) else {}
        payload = None
        if body is not None and method_text not in {"GET", "HEAD"}:
            if isinstance(body, (dict, list)):
                payload = json.dumps(body, ensure_ascii=False).encode("utf-8")
                header_dict.setdefault("Content-Type", "application/json; charset=utf-8")
            elif isinstance(body, bytes):
                payload = body
            else:
                payload = str(body).encode("utf-8")
        request = _urlrequest.Request(url_text, data=payload, headers=header_dict, method=method_text)
        try:
            try:
                response = _urlrequest.urlopen(request, timeout=max(0.1, float(timeout)))
            except _urlerror.HTTPError as http_error:
                # HTTP errors still provide a status and sometimes a helpful response body.
                response = http_error
            with response:
                raw_body = response.read(2_000_001)
                truncated = len(raw_body) > 2_000_000
                raw_body = raw_body[:2_000_000]
                content_type = response.headers.get("Content-Type", "")
                charset_match = re.search(r"charset=([^;\s]+)", content_type, flags=re.I)
                charset = charset_match.group(1).strip('"\'') if charset_match else "utf-8"
                try:
                    decoded = raw_body.decode(charset, errors="replace")
                except LookupError:
                    decoded = raw_body.decode("utf-8", errors="replace")
                return {
                    "status": int(getattr(response, "status", response.getcode())),
                    "reason": str(getattr(response, "reason", "")),
                    "url": str(response.geturl()),
                    "headers": {str(k): str(v) for k, v in response.headers.items()},
                    "body": decoded,
                    "truncated": truncated,
                }
        except (OSError, ValueError, _urlerror.URLError) as exc:
            raise EasyScriptError(f"HTTP request failed for {url_text!r}: {exc}") from exc

    @classmethod
    def _http_get(cls, url: Any, timeout: Any = 10, headers: Any = None) -> str:
        return str(cls._http_request(url, "GET", None, headers, timeout)["body"])

    @classmethod
    def _http_post(cls, url: Any, body: Any, content_type: Any = "application/json", timeout: Any = 10, headers: Any = None) -> dict[str, Any]:
        header_dict = dict(headers) if isinstance(headers, dict) else {}
        header_dict.setdefault("Content-Type", str(content_type))
        return cls._http_request(url, "POST", body, header_dict, timeout)

    @staticmethod
    def _url_encode(value: Any) -> str:
        if isinstance(value, dict):
            return _urlparse.urlencode(value, doseq=True)
        return _urlparse.quote(str(value), safe="")

    @staticmethod
    def _url_query(value: Any) -> str:
        if not isinstance(value, dict):
            raise EasyScriptError('URL_QUERY verwacht een woordenboek, bijvoorbeeld {"zoek": "hallo wereld"}')
        return _urlparse.urlencode(value, doseq=True)

