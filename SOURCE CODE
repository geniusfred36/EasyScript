# --------------------------- EasyScript expressions ------------------------
_TOKEN_RE = re.compile(
    r"(?P<SPACE>\s+)"
    r"|(?P<NUMBER>(?:\d+\.\d*|\.\d+|\d+)(?:[eE][+-]?\d+)?)"
    r"|(?P<STRING>\"(?:\\.|[^\"\\])*\"|'(?:\\.|[^'\\])*')"
    r"|(?P<IDENT>[A-Za-z_][A-Za-z0-9_]*)"
    r"|(?P<OP>\*\*|//|==|!=|<=|>=|\+=|-=|\*=|/=|%=|[+\-*/%<>()\[\]{},:])"
)


def _decode_string(token: str) -> str:
    if token.startswith('"'):
        try:
            return json.loads(token)
        except Exception:
            pass
    body = token[1:-1]
    replacements = {"\\n": "\n", "\\r": "\r", "\\t": "\t", "\\b": "\b", "\\f": "\f", "\\\\": "\\", "\\'": "'", '\\"': '"'}
    for old, new in replacements.items():
        body = body.replace(old, new)
    return body


class ExpressionParser:
    """Small Pratt parser. It parses EasyScript expressions, never Python code."""
    PRECEDENCE = {
        "or": 10,
        "and": 20,
        "==": 30, "!=": 30, "<": 30, "<=": 30, ">": 30, ">=": 30,
        "in": 30, "not in": 30,
        "+": 40, "-": 40,
        "*": 50, "/": 50, "//": 50, "%": 50,
        "**": 60,
    }

    def __init__(self, runtime: "EasyScriptRuntime", source: str):
        self.runtime = runtime
        self.source = source
        self.tokens: list[tuple[str, str]] = []
        pos = 0
        while pos < len(source):
            match = _TOKEN_RE.match(source, pos)
            if not match:
                raise EasyScriptError(f"Onbekend teken in expressie bij positie {pos}: {source[pos:pos+12]!r}")
            kind = match.lastgroup or ""
            token = match.group()
            pos = match.end()
            if kind != "SPACE":
                self.tokens.append((kind, token))
        self.tokens.append(("EOF", ""))
        self.index = 0

    def peek(self) -> tuple[str, str]:
        return self.tokens[self.index]

    def take(self) -> tuple[str, str]:
        token = self.peek()
        self.index += 1
        return token

    def accept(self, value: str) -> bool:
        if self.peek()[1].lower() == value.lower():
            self.take()
            return True
        return False

    def expect(self, value: str) -> None:
        if not self.accept(value):
            raise EasyScriptError(f"Verwacht {value!r} in expressie {self.source!r}")

    def parse(self) -> Any:
        if self.peek()[0] == "EOF":
            return None
        value = self.expression(0)
        if self.peek()[0] != "EOF":
            raise EasyScriptError(f"Onverwacht token {self.peek()[1]!r} in expressie {self.source!r}")
        return value

    def expression(self, min_precedence: int) -> Any:
        left = self.prefix()
        while True:
            kind, raw_op = self.peek()
            op = raw_op.lower()
            if kind == "OP" and op == "(":
                self.take()
                args = self.parse_arguments(")")
                left = self.runtime.call_value(left, args)
                continue
            if kind == "OP" and op == "[":
                self.take()
                left = self.parse_index(left)
                continue
            if kind == "IDENT" and op == "not":
                if self.index + 1 < len(self.tokens) and self.tokens[self.index + 1][1].lower() == "in":
                    op = "not in"
                else:
                    break
            if op not in self.PRECEDENCE or self.PRECEDENCE[op] < min_precedence:
                break
            self.take()
            if op == "not in":
                self.expect("in")
            precedence = self.PRECEDENCE[op]
            right = self.expression(precedence if op == "**" else precedence + 1)
            left = self.apply_operator(op, left, right)
        return left

    def prefix(self) -> Any:
        kind, token = self.take()
        lower = token.lower()
        if kind == "NUMBER":
            return float(token) if any(c in token for c in ".eE") else int(token)
        if kind == "STRING":
            return _decode_string(token)
        if kind == "IDENT":
            if lower in ("true", "waar"):
                return True
            if lower in ("false", "onwaar"):
                return False
            if lower in ("none", "null", "niks"):
                return None
            if lower == "not":
                return not bool(self.expression(70))
            if lower in ("pi", "e", "tau", "inf", "nan"):
                return {"pi": math.pi, "e": math.e, "tau": math.tau, "inf": math.inf, "nan": math.nan}[lower]
            return self.runtime.resolve_name(token)
        if kind == "OP" and token in ("-", "+"):
            value = self.expression(70)
            return -value if token == "-" else +value
        if kind == "OP" and token == "(":
            value = self.expression(0)
            if self.accept(","):
                values = [value]
                while True:
                    values.append(self.expression(0))
                    if not self.accept(","):
                        break
                self.expect(")")
                return tuple(values)
            self.expect(")")
            return value
        if kind == "OP" and token == "[":
            values = []
            if not self.accept("]"):
                while True:
                    values.append(self.expression(0))
                    if self.accept("]"):
                        break
                    self.expect(",")
                    if self.accept("]"):
                        break
            return values
        if kind == "OP" and token == "{":
            result = {}
            if not self.accept("}"):
                while True:
                    key = self.expression(0)
                    self.expect(":")
                    value = self.expression(0)
                    result[key] = value
                    if self.accept("}"):
                        break
                    self.expect(",")
                    if self.accept("}"):
                        break
            return result
        raise EasyScriptError(f"Onverwacht token {token!r} in expressie {self.source!r}")

    def parse_arguments(self, end_token: str) -> list[Any]:
        args = []
        if self.accept(end_token):
            return args
        while True:
            args.append(self.expression(0))
            if self.accept(end_token):
                break
            self.expect(",")
            if self.accept(end_token):
                break
        return args

    def parse_index(self, target: Any) -> Any:
        first = None
        if not self.accept(":"):
            first = self.expression(0)
        if self.accept(":"):
            stop = None if self.peek()[1] in (":", "]") else self.expression(0)
            step = None
            if self.accept(":"):
                step = None if self.peek()[1] == "]" else self.expression(0)
            self.expect("]")
            return target[slice(first, stop, step)]
        self.expect("]")
        return target[first]

    @staticmethod
    def apply_operator(op: str, left: Any, right: Any) -> Any:
        try:
            if op == "+": return left + right
            if op == "-": return left - right
            if op == "*": return left * right
            if op == "/": return left / right
            if op == "//": return left // right
            if op == "%": return left % right
            if op == "**": return left ** right
            if op == "==": return left == right
            if op == "!=": return left != right
            if op == "<": return left < right
            if op == "<=": return left <= right
            if op == ">": return left > right
            if op == ">=": return left >= right
            if op == "in": return left in right
            if op == "not in": return left not in right
            if op == "and": return bool(left) and bool(right)
            if op == "or": return bool(left) or bool(right)
        except Exception as exc:
            raise EasyScriptError(f"Kan {left!r} {op} {right!r} niet berekenen: {exc}") from exc
        raise EasyScriptError(f"Unknown operator: {op}")


# ------------------------------- Runtime -----------------------------------
class EasyScriptRuntime:
    def __init__(self, script_path: str | None = None):
        self.variables: dict[str, Any] = {}
        self.scopes: list[dict[str, Any]] = []
        self.functions: dict[str, EasyFunction] = {}
        self.script_path = os.path.abspath(script_path or __file__)
        self.script_dir = os.path.dirname(self.script_path)
        self.loop_limit = 100_000
        self.try_depth = 0
        self.remote_server_started = False
        self.builtins: dict[str, Callable[..., Any]] = {}
        self._register_builtins()

    def resolve_path(self, filename: Any) -> str:
        name = str(filename).strip().strip('"').strip("'")
        if os.path.isabs(name):
            return name
        first = os.path.join(self.script_dir, name)
        second = os.path.join(os.getcwd(), name)
        return first if os.path.exists(first) or not os.path.exists(second) else second

    def resolve_name(self, name: str) -> Any:
        if name in self.scopes[-1] if self.scopes else False:
            return self.scopes[-1][name]
        if name in self.variables:
            return self.variables[name]
        if name in self.functions:
            return self.functions[name]
        if name.lower() in self.builtins:
            return self.builtins[name.lower()]
        raise EasyScriptError(f"Unknown name: {name!r}. Use quotation marks for text.")

    def set_var(self, name: str, value: Any) -> None:
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise EasyScriptError(f"Invalid variable name: {name!r}")
        if self.scopes:
            self.scopes[-1][name] = value
        else:
            self.variables[name] = value

    def eval_expr(self, source: str) -> Any:
        return ExpressionParser(self, source.strip()).parse()

    def call_value(self, fn: Any, args: list[Any]) -> Any:
        if isinstance(fn, EasyFunction):
            return self.call_user_function(fn, args)
        if callable(fn):
            try:
                return fn(*args)
            except EasyScriptError:
                raise
            except Exception as exc:
                raise EasyScriptError(f"Function raised an error: {exc}") from exc
        raise EasyScriptError(f"Dit kan niet als functie worden aangeroepen: {fn!r}")

    def call_user_function(self, fn: EasyFunction, args: list[Any]) -> Any:
        required = len(fn.params) - len(fn.defaults)
        if len(args) < required or len(args) > len(fn.params):
            raise EasyScriptError(f"Functie {fn.name} verwacht {required} tot {len(fn.params)} argument(en), kreeg {len(args)}")
        local_scope = dict(zip(fn.params, args))
        for param, default_value in fn.defaults.items():
            if param not in local_scope:
                local_scope[param] = default_value
        self.scopes.append(local_scope)
        try:
            self.execute_range(fn.body, 0, len(fn.body))
        except ReturnSignal as ret:
            return ret.value
        finally:
            self.scopes.pop()
        return None

    def _register(self, names: str, fn: Callable[..., Any]) -> None:
        for name in names.split():
            self.builtins[name.lower()] = fn

